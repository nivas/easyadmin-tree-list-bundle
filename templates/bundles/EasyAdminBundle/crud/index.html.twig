{# EasyAdmin 4 port of the tree list view.
   Activated per-CRUD by configureResponseParameters() setting 'tree' => true.
   Rows get data-root-id / data-parent-id straight from the entity's tree
   associations (EA4's entity_row_attributes block hook makes the old
   lft/rgt-based parent reconstruction unnecessary), and jquery.treetable
   renders the expandable tree. #}
{% extends '@!EasyAdmin/crud/index.html.twig' %}

{% block entity_row_attributes %}
    {%- if tree is defined and tree -%}
        {%- set _instance = entity.instance -%}
        {%- if _instance.root is defined and _instance.root -%} data-root-id="{{ _instance.root.id }}"{%- endif -%}
        {%- if _instance.parent is defined and _instance.parent -%} data-parent-id="{{ _instance.parent.id }}"{%- endif -%}
    {%- endif -%}
{% endblock %}

{% block body_javascript %}
    {{ parent() }}
    {% if tree is defined and tree %}
    <script type="text/javascript">
        $(document).ready(function () {
            // filtered/searched subsets may not contain a row's parent —
            // treetable would hide such rows, so detach the missing parents first
            document.querySelectorAll('#main table tbody tr[data-parent-id]').forEach(function (tr) {
                var pid = tr.getAttribute('data-parent-id');
                if (!document.querySelector('#main table tbody tr[data-id="' + pid + '"]')) {
                    tr.removeAttribute('data-parent-id');
                }
            });
            $('#main table').treetable({ expandable: true, nodeIdAttr: 'id', parentIdAttr: 'parentId', indent: 19 });
        });
    </script>
    {% endif %}
{% endblock %}
